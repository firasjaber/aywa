{
	"name": "aywa",
	"private": true,
	"version": "0.1.1",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=22.15.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"tauri": "set \"PATH=%USERPROFILE%\\.cargo\\bin;%PATH%\" && tauri",
		"prepare:python-runtime:lock": "powershell -ExecutionPolicy Bypass -File scripts/prepare-python-runtime.ps1 -UpdateLock",
		"prepare:python-runtime": "powershell -ExecutionPolicy Bypass -File scripts/prepare-python-runtime.ps1",
		"verify:release-policy": "node scripts/verify-release-policy.mjs",
		"tauri:dev:managed-python": "npm run prepare:python-runtime && set \"AYWA_PYTHON_RUNTIME=managed\" && npm run tauri -- dev",
		"tauri:build": "npm run prepare:python-runtime && npm run tauri -- build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tauri-apps/cli": "2.10.1",
		"@types/node": "^24.9.1",
		"svelte": "^5.54.0",
		"svelte-check": "^4.4.2",
		"typescript": "^5.9.3",
		"vite": "^7.3.1"
	},
	"dependencies": {
		"@tauri-apps/api": "2.10.1",
		"@tauri-apps/plugin-opener": "2.5.4"
	}
}
