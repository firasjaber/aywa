{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Aywa",
  "version": "0.2.0",
  "identifier": "com.aywa.speech",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Aywa Settings",
        "url": "/",
        "width": 600,
        "height": 560,
        "minWidth": 520,
        "minHeight": 460,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      },
      {
        "label": "overlay",
        "title": "Aywa Overlay",
        "url": "/overlay",
        "width": 168,
        "height": 44,
        "visible": false,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focusable": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": [
      "resources/python/*"
    ],
    "icon": [
      "../static/logo/png/app-dark/aywa-dark-1024.png",
      "../static/logo/desktop/macos/aywa.icns",
      "../static/logo/desktop/windows/aywa.ico"
    ]
  }
}
